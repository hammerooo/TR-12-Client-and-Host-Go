{
  "version": { "version": "11.0.0" },
  "settings": [
    {
      "name": "Clock Source",
      "description": "Sets the clock source for all active channels.",
      "id": "clocksync",
      "constraint": {
        "enums": {
          "values": ["INTERNAL", "GENLOCK", "NTP", "PTP"],
          "defaultValue": "NTP"
        }
      }
    }
  ],
  "channelTemplates": [
    {
      "id": "main",
      "channelType": "SOURCE",
      "protocols": ["SRT_CALLER", "SRT_LISTENER"],
      "profiles": [
        { "name": "h264_contribution_compact", "id": "h264c",  "description": "H264, 30fps, 10mbs, 720p, 6s gop" },
        { "name": "h264_contribution_full",    "id": "h264f",  "description": "H264, 60fps, 20mbs, 1080p, 3s gop" },
        { "name": "h265_contribution_compact", "id": "h265c",  "description": "H265, 30fps, 10mbs, 1080p, 3s gop" },
        { "name": "h265_4k",                   "id": "h265k",  "description": "H265, 60fps, 40mps, 4k, 3s gop" },
        { "name": "h265_4k_low_latency",       "id": "h265kl", "description": "H265, 60fps, 40mps, 4k, 500ms gop" }
      ],
      "settings": [
        { "name": "resolution", "description": "Output video dimensions.", "id": "RS01",
          "constraint": { "enums": { "values": ["1920x1080","1280x720","1080x720","640x480"], "defaultValue": "1920x1080" } } },
        { "name": "framerate", "description": "Frames per second (fps).", "id": "FR01",
          "constraint": { "enums": { "values": ["30","60","90","25"], "defaultValue": "30" } } },
        { "name": "max_bitrate", "description": "Maximum data rate limit (Kbps).", "id": "MB01",
          "constraint": { "ranges": { "minimum": 5000, "maximum": 50000, "defaultValue": 10000 } } },
        { "name": "rate_control", "description": "Method used to control the output bitrate.", "id": "RC01",
          "constraint": { "enums": { "values": ["CBR","VBR","ABR"], "defaultValue": "CBR" } } },
        { "name": "codec", "description": "Video compression standard.", "id": "CO01",
          "constraint": { "enums": { "values": ["H.264","H.265"], "defaultValue": "H.264" } } },
        { "name": "gop_size", "description": "Group of Pictures (I-frame interval in frames).", "id": "GP01",
          "constraint": { "enums": { "values": ["30","60","90"], "defaultValue": "60" } } },
        { "name": "selected_input", "description": "Hardware input source selection.", "id": "IN01",
          "constraint": { "enums": { "values": ["SDI1","HDMI1","IP"], "defaultValue": "SDI1" } } }
      ]
    }
  ],
  "channelAssignments": [
    { "channelId": "CH01", "name": "Channel 1", "templateId": "main" }
  ]
}
